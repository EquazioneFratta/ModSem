                          :Manga ;
              rdfs:range xsd:boolean .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/numeroCapitoli
:numeroCapitoli rdf:type owl:DatatypeProperty ;
                rdfs:domain :MangaSerie ;
                rdfs:range xsd:integer .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/titoloPrincipale
:titoloPrincipale rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Anime ,
                              :Manga ;
                  rdfs:range xsd:string .


