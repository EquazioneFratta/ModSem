    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/èDoppiatoDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/èDoppiatoDa">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
