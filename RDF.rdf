        <skos:exactMatch>https://www.wikidata.org/wiki/Property:P123</skos:exactMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/èAdattamentodi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/èAdattamentodi">
