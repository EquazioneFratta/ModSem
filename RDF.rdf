    <!-- http://www.semanticweb.org/japanese-media/detieneDiritti -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/detieneDiritti">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/japanese-media/sottoLicenzaDi"/>
