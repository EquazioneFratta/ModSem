        <rdfs:label xml:lang="it">Pubblica</rdfs:label>
        <skos:exactMatch>https://www.wikidata.org/wiki/Q66759300</skos:exactMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/pubblicatoIn -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/pubblicatoIn">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Rivista"/>
        <rdfs:comment xml:lang="it">Indica il manga su che rivista è stato pubblicato</rdfs:comment>
        <rdfs:label xml:lang="it">Pubblicato in</rdfs:label>
        <skos:exactMatch>https://www.wikidata.org/wiki/Property:P1433</skos:exactMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/sottoLicenzaDi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/sottoLicenzaDi">
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/CasaEditrice"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/pubblicatoIn"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/stampataDa"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="it">indica a quale casa editrice il manga ha dato licenza</rdfs:comment>
        <rdfs:label xml:lang="it">Sotto licenza di</rdfs:label>
        <skos:closeMatch>https://www.wikidata.org/wiki/Q70232435</skos:closeMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/stampa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/stampa">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/japanese-media/stampataDa"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/CasaEditrice"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Rivista"/>
        <rdfs:comment xml:lang="it">Indica una casa editrice quale riviste pubblica</rdfs:comment>
        <rdfs:label xml:lang="it">Stampa</rdfs:label>
        <skos:exactMatch>https://www.wikidata.org/wiki/Q80458177</skos:exactMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/stampataDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/stampataDa">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Rivista"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/CasaEditrice"/>
