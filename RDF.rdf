    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/numeroEpisodi -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/japanese-media/numeroEpisodi">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/AnimeSerie"/>
