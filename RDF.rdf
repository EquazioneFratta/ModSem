    <!-- http://www.semanticweb.org/japanese-media/dipendenteDi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/dipendenteDi">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/japanese-media/haDipendente"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Persona"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Staff"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Organizzazione"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/StudioAnimazione"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/haDiretto"/>
            <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/prodottoDa"/>
        </owl:propertyChainAxiom>
        <rdfs:comment xml:lang="it">Indica di quale studio di animazione è dipendente un dipendente</rdfs:comment>
        <rdfs:label xml:lang="it">Dipendente di</rdfs:label>
        <skos:exactMatch>https://schema.org/worksFor</skos:exactMatch>
        <skos:exactMatch>https://www.wikidata.org/wiki/Property:P108</skos:exactMatch>
    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/direttoDa -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/direttoDa">
        <owl:inverseOf rdf:resource="http://www.semanticweb.org/japanese-media/haDiretto"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/OperaArtistica"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/OperaNipponica"/>
        <rdfs:domain>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/OperaArtistica"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/japanese-media/haTarget"/>
                        <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/japanese-media/Target"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:domain>
        <rdfs:domain>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/japanese-media/haTarget"/>
                <owl:someValuesFrom rdf:resource="http://www.semanticweb.org/japanese-media/Target"/>
            </owl:Restriction>
        </rdfs:domain>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Persona"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Regista"/>
        <rdfs:range rdf:resource="http://www.semanticweb.org/japanese-media/Staff"/>
        <rdfs:range>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://www.semanticweb.org/japanese-media/Staff"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.semanticweb.org/japanese-media/haDiretto"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.semanticweb.org/japanese-media/haDiretto"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
