    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Bag -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Bag">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/ArcoNarrativo"/>
        <rdfs:comment>Bag - Collection that can have a number of copies of each object</rdfs:comment>
        <rdfs:label>(collections) Bag</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemContent"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/list.owl#List"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <rdfs:comment>Item - Element belonging to a Bag</rdfs:comment>
        <rdfs:label>item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection">
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/ArcoNarrativo"/>
        <rdfs:comment>Any container for entities that share one or more common properties. E.g. &quot;stone objects&quot;, &quot;the nurses&quot;, &quot;the Louvre Aegyptian collection&quot;. A collection is not a logical class: a collection is a first-order entity, while a class is a second-order one.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl"/>
        <rdfs:label xml:lang="en">Collection</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/list.owl#List -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/list.owl#List">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Bag"/>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/ArcoNarrativo"/>
        <rdfs:comment>List - An ordered array of items, that can be present in multiple copies</rdfs:comment>
        <rdfs:label>list</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <rdfs:comment>ListItem - Element belonging to a list</rdfs:comment>
        <rdfs:label>list item</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeFilm"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeSerie"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/LongRunning"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaOneShot"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OVA"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OperaArtistica"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OperaNipponica"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Stagionale"/>
        <rdfs:comment>Any physical, social, or mental process, event, or state.</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl"/>
        <rdfs:label xml:lang="en">Event</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object -->

    <owl:Class rdf:about="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn"/>
                <owl:someValuesFrom rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeAward"/>
        <rdfs:comment>Any physical, social, or mental object, or substance</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl"/>
        <rdfs:label xml:lang="en">Object</rdfs:label>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/japanese-media/Anime -->

    <owl:Class rdf:about="http://www.semanticweb.org/japanese-media/Anime">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/japanese-media/OperaNipponica"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeAward"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaOneShot"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <rdfs:comment xml:lang="it">Prodotto di animazione giapponese spesso tratto da manga o videogames</rdfs:comment>
        <rdfs:label xml:lang="it">Anime</rdfs:label>
        <skos:broadMatch>https://schema.org/VideoObject</skos:broadMatch>
        <skos:exactMatch>http://www.wikidata.org/entity/Q1107</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/japanese-media/AnimeAward -->

    <owl:Class rdf:about="http://www.semanticweb.org/japanese-media/AnimeAward">
        <rdfs:subClassOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeFilm"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/AnimeSerie"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/LongRunning"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaOneShot"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OVA"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OperaArtistica"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/OperaNipponica"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Stagionale"/>
        <rdfs:comment xml:lang="it">Premio annuale per migliori anime</rdfs:comment>
        <rdfs:label xml:lang="it">Anime award</rdfs:label>
        <skos:broadMatch>https://schema.org/award</skos:broadMatch>
        <skos:exactMatch>https://www.wikidata.org/wiki/Q105725170</skos:exactMatch>
    </owl:Class>
    


    <!-- http://www.semanticweb.org/japanese-media/AnimeFilm -->

    <owl:Class rdf:about="http://www.semanticweb.org/japanese-media/AnimeFilm">
        <rdfs:subClassOf rdf:resource="http://www.semanticweb.org/japanese-media/Anime"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaCompleto"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaInCorso"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaOneShot"/>
        <owl:disjointWith rdf:resource="http://www.semanticweb.org/japanese-media/MangaSerie"/>
        <rdfs:comment xml:lang="it">Film di animazione giapponese</rdfs:comment>
        <rdfs:label xml:lang="it">Film anime</rdfs:label>
        <skos:closeMatch>https://schema.org/Movie</skos:closeMatch>
