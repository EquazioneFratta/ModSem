    </owl:ObjectProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/èVincitoreDi -->

    <owl:ObjectProperty rdf:about="http://www.semanticweb.org/japanese-media/èVincitoreDi">
        <rdfs:subPropertyOf rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#InverseFunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object"/>
        <rdfs:range rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event"/>
        <rdfs:comment xml:lang="it">Indica iil vincitore di un evento</rdfs:comment>
        <rdfs:label xml:lang="it">E&apos; vincitore di</rdfs:label>
        <skos:exactMatch>https://www.wikidata.org/wiki/Q106361078</skos:exactMatch>
    </owl:ObjectProperty>
    


