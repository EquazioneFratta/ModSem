        <rdfs:domain rdf:resource="http://www.ontologydesignpatterns.org/cp/owl/collectionentity.owl#Collection"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment>size - The number of items belonging to a collection</rdfs:comment>
        <rdfs:label>size</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- http://www.semanticweb.org/japanese-media/inProduzione -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/japanese-media/inProduzione">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/OperaNipponica"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
