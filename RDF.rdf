    <!-- http://www.semanticweb.org/japanese-media/numeroVolumi -->

    <owl:DatatypeProperty rdf:about="http://www.semanticweb.org/japanese-media/numeroVolumi">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.semanticweb.org/japanese-media/Manga"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
        <rdfs:comment xml:lang="it">Indica il numero di volumi di un manga</rdfs:comment>
