@prefix : <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .

<http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16> rdf:type owl:Ontology ;
                                                                           owl:imports <http://www.ontologydesignpatterns.org/cp/owl/list.owl> ;
                                                                           dc:creator "Frattarola Marco" ,
                                                                                      "Ghione Alessio" ;
                                                                           dc:date "2025-01-31" ;
                                                                           dc:description "" ;
                                                                           dc:title "Ontologia sui media giapponesi" ;
                                                                           vann:preferredNamespacePrefix "jm" ;
                                                                           rdfs:label "Japanese media" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/appartieneA
:appartieneA rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Rivista ;
             rdfs:range :CasaEditrice .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/collegaDi
:collegaDi rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Staff ;
           rdfs:range :Staff .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/detieneDiritti
:detieneDiritti rdf:type owl:ObjectProperty ;
                rdfs:domain :CasaEditrice ;
                rdfs:range :Manga ;
                owl:propertyChainAxiom ( :pubblicatoDa
                                         :appartieneA
                                       ) .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/dipendenteDi
:dipendenteDi rdf:type owl:ObjectProperty ;
              rdfs:domain :Staff ;
              rdfs:range :StudioAnimazione ;
              owl:propertyChainAxiom ( :haDiretto
                                       :prodottoDa
                                     ) .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/direttoDa
:direttoDa rdf:type owl:ObjectProperty ;
           owl:inverseOf :haDiretto ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Anime ;
           rdfs:range :Regista .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haAdattamentoAnime
:haAdattamentoAnime rdf:type owl:ObjectProperty ;
                    rdfs:domain :Manga ;
                    rdfs:range :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haAutore
:haAutore rdf:type owl:ObjectProperty ;
          owl:inverseOf :haScritto ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :OperaArtistica ;
          rdfs:range :Autore .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haDiretto
:haDiretto rdf:type owl:ObjectProperty ,
                    owl:InverseFunctionalProperty ;
           rdfs:domain :Regista ;
           rdfs:range :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haDoppiato
:haDoppiato rdf:type owl:ObjectProperty ;
            owl:inverseOf :èDoppiatoDa ;
            rdfs:domain :VoiceActorOrActress ;
            rdfs:range :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haLavoratoCon
:haLavoratoCon rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:domain :Staff ;
               rdfs:range :Staff ;
               owl:propertyChainAxiom ( :haDiretto
                                        :èDoppiatoDa
                                      ) .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haPrequel
:haPrequel rdf:type owl:ObjectProperty ;
           owl:inverseOf :haSequel ;
           rdf:type owl:TransitiveProperty ;
           rdfs:domain :OperaArtistica ;
           rdfs:range :OperaArtistica ;
           owl:propertyChainAxiom ( :haPrequel
                                    :haPrequel
                                  ) .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haPrimoArcoNarrativo
:haPrimoArcoNarrativo rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasFirstItem> .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haProdotto
:haProdotto rdf:type owl:ObjectProperty ;
            owl:inverseOf :prodottoDa ;
            rdf:type owl:InverseFunctionalProperty ;
            rdfs:domain :StudioAnimazione ;
            rdfs:range :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haScritto
:haScritto rdf:type owl:ObjectProperty ,
                    owl:InverseFunctionalProperty ;
           rdfs:domain :Autore ;
           rdfs:range :Manga .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haSequel
:haSequel rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :OperaArtistica ;
          rdfs:range :OperaArtistica ;
          owl:propertyChainAxiom ( :haSequel
                                   :haSequel
                                 ) .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haTarget
:haTarget rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :OperaNipponica ;
          rdfs:range :Target .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haUltimoArcoNrattaivo
:haUltimoArcoNrattaivo rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasLastItem> .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/prodottoDa
:prodottoDa rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Anime ;
            rdfs:range :StudioAnimazione .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/pubblicatoDa
:pubblicatoDa rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Manga ;
              rdfs:range :Rivista .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/èDoppiatoDa
:èDoppiatoDa rdf:type owl:ObjectProperty ;
             rdfs:domain :Anime ;
             rdfs:range :VoiceActorOrActress .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/inProduzione
:inProduzione rdf:type owl:DatatypeProperty ;
              rdfs:domain :OperaNipponica ;
              rdfs:range xsd:boolean .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/numeroEpisodi
:numeroEpisodi rdf:type owl:DatatypeProperty ;
               rdfs:domain :AnimeSerie ;
               rdfs:range xsd:integer .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/prezzoVolumeEuro
:prezzoVolumeEuro rdf:type owl:DatatypeProperty ;
                  rdfs:domain :Manga ;
                  rdfs:range xsd:decimal .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/titoloAlternativo
:titoloAlternativo rdf:type owl:DatatypeProperty ;
                   rdfs:domain :OperaNipponica ;
                   rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Anime
:Anime rdf:type owl:Class ;
       rdfs:subClassOf :OperaNipponica ;
       owl:disjointWith :Manga .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/AnimeFilm
:AnimeFilm rdf:type owl:Class ;
           rdfs:subClassOf :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/AnimeSerie
:AnimeSerie rdf:type owl:Class ;
            rdfs:subClassOf :Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/ArcoNarrativo
:ArcoNarrativo rdf:type owl:Class ;
               rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem> .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Autore
:Autore rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :Persona
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :haScritto ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass :Manga
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :Persona .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/CasaEditrice
:CasaEditrice rdf:type owl:Class ;
              rdfs:subClassOf :Organizzazione .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/LongRunning
:LongRunning rdf:type owl:Class ;
             rdfs:subClassOf :TVSeries .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Manga
:Manga rdf:type owl:Class ;
       rdfs:subClassOf :OperaNipponica .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaCompleto
:MangaCompleto rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :MangaSerie
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :pubblicatoDa ;
                                                            owl:someValuesFrom :Rivista
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :inProduzione ;
                                                            owl:hasValue "false"^^xsd:boolean
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :MangaSerie .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaInCorso
:MangaInCorso rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :MangaSerie
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :pubblicatoDa ;
                                                           owl:someValuesFrom :Rivista
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :inProduzione ;
                                                           owl:hasValue "true"^^xsd:boolean
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :MangaSerie .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaOneShot
:MangaOneShot rdf:type owl:Class ;
              rdfs:subClassOf :Manga .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaSerie
:MangaSerie rdf:type owl:Class ;
            rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#List> ,
                            :Manga .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/OVA
:OVA rdf:type owl:Class ;
     rdfs:subClassOf :AnimeSerie .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/OperaArtistica
:OperaArtistica rdf:type owl:Class .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/OperaNipponica
:OperaNipponica rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( :OperaArtistica
                                                           [ rdf:type owl:Restriction ;
                                                             owl:onProperty :haTarget ;
                                                             owl:someValuesFrom :Target
                                                           ]
                                                         ) ;
                                      rdf:type owl:Class
                                    ] ;
                rdfs:subClassOf :OperaArtistica .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Organizzazione
:Organizzazione rdf:type owl:Class .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Persona
:Persona rdf:type owl:Class .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Regista
:Regista rdf:type owl:Class ;
         rdfs:subClassOf :Staff .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Rivista
:Rivista rdf:type owl:Class .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/RivistaMonthly
:RivistaMonthly rdf:type owl:Class ;
                rdfs:subClassOf :Rivista .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/RivistaWeekly
:RivistaWeekly rdf:type owl:Class ;
               rdfs:subClassOf :Rivista .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Staff
:Staff rdf:type owl:Class ;
       rdfs:subClassOf :Persona .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Stagionale
:Stagionale rdf:type owl:Class ;
            rdfs:subClassOf :TVSeries .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/StudioAnimazione
:StudioAnimazione rdf:type owl:Class ;
                  rdfs:subClassOf :Organizzazione .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/TVSeries
:TVSeries rdf:type owl:Class ;
          rdfs:subClassOf :AnimeSerie .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Target
:Target rdf:type owl:Class ;
        owl:equivalentClass [ rdf:type owl:Class ;
                              owl:oneOf ( :Josei
                                          :Kodomo
                                          :Seinen
                                          :Shojo
                                          :Shonen
                                        )
                            ] .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/VoiceActorOrActress
:VoiceActorOrActress rdf:type owl:Class ;
                     rdfs:subClassOf :Staff .


#################################################################
#    Individuals
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Assassinio_del_portatore_della_spada
:Assassinio_del_portatore_della_spada rdf:type owl:NamedIndividual ,
                                               :ArcoNarrativo .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Death_Parade_Anime
:Death_Parade_Anime rdf:type owl:NamedIndividual ,
                             :Stagionale ;
                    :prodottoDa :Madhouse ;
                    :inProduzione "false"^^xsd:boolean ;
                    :numeroEpisodi 12 .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Futabasha
:Futabasha rdf:type owl:NamedIndividual ,
                    :CasaEditrice .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Hoshi_Mamoru_Inu
:Hoshi_Mamoru_Inu rdf:type owl:NamedIndividual ,
                           :MangaOneShot ;
                  :haSequel :Hoshi_Mamoru_Inu_2 ;
                  :haTarget :Seinen ;
                  :pubblicatoDa :Weekly_Manga_Action ;
                  :titoloAlternativo "Il cane che guarda le stelle" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Hoshi_Mamoru_Inu_2
:Hoshi_Mamoru_Inu_2 rdf:type owl:NamedIndividual ,
                             :MangaOneShot ;
                    :haTarget :Seinen ;
                    :pubblicatoDa :Weekly_Manga_Action .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Kagurabachi
:Kagurabachi rdf:type owl:NamedIndividual ,
                      :MangaInCorso ;
             <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#hasItem> :Assassinio_del_portatore_della_spada ,
                                                                            :Rakuzaichi ;
             :haPrimoArcoNarrativo :Versus_Shojo ;
             :haTarget :Shonen ;
             :pubblicatoDa :Shonen_Jump .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Rakuzaichi
:Rakuzaichi rdf:type owl:NamedIndividual ,
                     :ArcoNarrativo ;
            <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :Assassinio_del_portatore_della_spada .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Takashi_Murakami
:Takashi_Murakami rdf:type owl:NamedIndividual ,
                           :Autore ;
                  :haScritto :Hoshi_Mamoru_Inu .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Takeru_Hokazono
:Takeru_Hokazono rdf:type owl:NamedIndividual ;
                 :haScritto :Kagurabachi .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Tomoaki_Maeno
:Tomoaki_Maeno rdf:type owl:NamedIndividual ;
               :haDoppiato :Death_Parade_Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Versus_Shojo
:Versus_Shojo rdf:type owl:NamedIndividual ,
                       :ArcoNarrativo ;
              <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :Rakuzaichi .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Weekly_Manga_Action
:Weekly_Manga_Action rdf:type owl:NamedIndividual ,
                              :RivistaWeekly ;
                     :appartieneA :Futabasha .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16#Yuzuru_Tachikawa
:Yuzuru_Tachikawa rdf:type owl:NamedIndividual ;
                  :haDiretto :Death_Parade_Anime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Arena_Celeste
:Arena_Celeste rdf:type owl:NamedIndividual ,
                        :ArcoNarrativo ;
               <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :York_Shin_City .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Elezione_Nuovo_Predisente
:Elezione_Nuovo_Predisente rdf:type owl:NamedIndividual ,
                                    :ArcoNarrativo .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Esame_Degli_Hunter
:Esame_Degli_Hunter rdf:type owl:NamedIndividual ,
                             :ArcoNarrativo ;
                    <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :Zoldyck_e_il_recupero_di_Killua .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Formichimere
:Formichimere rdf:type owl:NamedIndividual ,
                       :ArcoNarrativo ;
              <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :Elezione_Nuovo_Predisente .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Greed_Island
:Greed_Island rdf:type owl:NamedIndividual ,
                       :ArcoNarrativo ;
              <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#precedes> :Formichimere .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Hiroshi_Kojina
:Hiroshi_Kojina rdf:type owl:NamedIndividual ;
                :haDiretto :HunterXHunterAnime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/HunterXHunter
:HunterXHunter rdf:type owl:NamedIndividual ,
                        :MangaSerie ;
               <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#hasItem> :Arena_Celeste ,
                                                                              :Esame_Degli_Hunter ,
                                                                              :Formichimere ,
                                                                              :Greed_Island ,
                                                                              :York_Shin_City ,
                                                                              :Zoldyck_e_il_recupero_di_Killua ;
               :haAdattamentoAnime :HunterXHunterAnime ;
               :haAutore :Yoshihiro_Togashi ;
               :haPrimoArcoNarrativo :Esame_Degli_Hunter ;
               :haTarget :Shonen ;
               :haUltimoArcoNrattaivo :Elezione_Nuovo_Predisente ;
               :pubblicatoDa :Shonen_Jump ;
               :inProduzione "false"^^xsd:boolean ;
               :prezzoVolumeEuro 5.5 ;
               :titoloAlternativo "HxH" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/HunterXHunterAnime
:HunterXHunterAnime rdf:type owl:NamedIndividual ;
                    :prodottoDa :Madhouse ;
                    :inProduzione "false"^^xsd:boolean ;
                    :numeroEpisodi 148 .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Josei
:Josei rdf:type owl:NamedIndividual ,
                :Target .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Kodomo
:Kodomo rdf:type owl:NamedIndividual ,
                 :Target .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Madhouse
:Madhouse rdf:type owl:NamedIndividual ,
                   :StudioAnimazione .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Megumi_Han
:Megumi_Han rdf:type owl:NamedIndividual ,
                     :VoiceActorOrActress ;
            :haDoppiato :HunterXHunterAnime .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Seinen
:Seinen rdf:type owl:NamedIndividual ,
                 :Target .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Shojo
:Shojo rdf:type owl:NamedIndividual ,
                :Target .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Shonen
