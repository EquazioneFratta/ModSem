@prefix : <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix jm: <http://www.semanticweb.org/japanese-media/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .

<http://www.semanticweb.org/japanese-media/> rdf:type owl:Ontology ;
                                              owl:imports <http://www.ontologydesignpatterns.org/cp/owl/list.owl> ,
                                                          <http://www.ontologydesignpatterns.org/cp/owl/participation.owl> ;
                                              dc:creator "Frattarola Marco" ,
                                                         "Ghione Alessio" ;
                                              dc:date "2025-01-20" ;
                                              dc:description "An ontology describing various aspects of Japanese media, including anime, manga, and related concepts."@en ,
                                                             "Un'ontologia che descrive vari aspetti dei media giapponesi, inclusi anime, manga e concetti correlati"@it ;
                                              dc:title "Japanese Media Ontology"@en ;
                                              vann:preferredNamespacePrefix "jm:" ;
                                              vann:preferredNamespaceUri "http://www.semanticweb.org/japanese-media/" ;
                                              rdfs:label "Japanese media" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
<http://www.w3.org/2004/02/skos/core#broadMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/japanese-media/appartieneA
jm:appartieneA rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain jm:Rivista ;
               rdfs:range jm:CasaEditrice ;
               rdfs:comment "Indica la rivista a quale casa editrice appartiene"@it ;
               rdfs:label "Appartiene a"@it .


###  http://www.semanticweb.org/japanese-media/arcoNarrativoDi
jm:arcoNarrativoDi rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemOf> ;
                   owl:inverseOf jm:haArcoNarrativo ;
                   rdf:type owl:FunctionalProperty ;
                   rdfs:domain jm:ArcoNarrativo ;
                   rdfs:range jm:MangaSerie ;
                   rdfs:comment "Indica a quale manga appartiene un arco narrativo"@it ;
                   rdfs:label "Arco narrativo di"@it .


###  http://www.semanticweb.org/japanese-media/collegaDi
jm:collegaDi rdf:type owl:ObjectProperty ,
                      owl:SymmetricProperty ,
                      owl:TransitiveProperty ;
             rdfs:domain jm:Staff ;
             rdfs:range jm:Staff ;
             rdfs:comment "Crea un collegamento che lega due colleghi"@it ;
             rdfs:label "Collega di"@it .


###  http://www.semanticweb.org/japanese-media/detieneDiritti
jm:detieneDiritti rdf:type owl:ObjectProperty ;
                  rdfs:domain jm:CasaEditrice ;
                  rdfs:range jm:Manga ;
                  owl:propertyChainAxiom ( jm:pubblicatoDa
                                           jm:appartieneA
                                         ) ;
                  rdfs:comment "Indica quale casa editrice detiene i diritti di pubblicazione di un certo manga"@it ;
                  rdfs:label "Detiene diritti"@it .


###  http://www.semanticweb.org/japanese-media/dipendenteDi
jm:dipendenteDi rdf:type owl:ObjectProperty ;
                rdfs:domain jm:Staff ;
                rdfs:range jm:StudioAnimazione ;
                owl:propertyChainAxiom ( jm:haDiretto
                                         jm:prodottoDa
                                       ) ;
                rdfs:comment "Indica di quale studio di animazione è dipendente un dipendente"@it ;
                rdfs:label "Dipendente di"@it .


###  http://www.semanticweb.org/japanese-media/direttoDa
jm:direttoDa rdf:type owl:ObjectProperty ;
             owl:inverseOf jm:haDiretto ;
             rdf:type owl:FunctionalProperty ;
             rdfs:domain jm:Anime ;
             rdfs:range jm:Regista ;
             rdfs:comment "Indica il regista di un determinato anime"@it ;
             rdfs:label "Diretto da"@it .


###  http://www.semanticweb.org/japanese-media/haAdattamentoAnime
jm:haAdattamentoAnime rdf:type owl:ObjectProperty ;
                      rdfs:domain jm:Manga ;
                      rdfs:range jm:Anime ;
                      rdfs:comment "Dato un manga indica quale anime è il suo adattamento"@it ;
                      rdfs:label "Ha adattamento anime"@it .


###  http://www.semanticweb.org/japanese-media/haArcoNarrativo
jm:haArcoNarrativo rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#hasItem> ;
                   rdf:type owl:InverseFunctionalProperty ;
                   rdfs:domain jm:MangaSerie ;
                   rdfs:range jm:ArcoNarrativo ;
                   rdfs:comment "indica quale archi narrativi ha un manga"@it ;
                   rdfs:label "Ha arco narrativo"@it .


###  http://www.semanticweb.org/japanese-media/haAutore
jm:haAutore rdf:type owl:ObjectProperty ;
            owl:inverseOf jm:haScritto ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain jm:Manga ;
            rdfs:range jm:Autore ;
            rdfs:comment "Indica quale autore ha scritto una determinata opera artistica"@it ;
            rdfs:label "Ha autore"@it .


###  http://www.semanticweb.org/japanese-media/haDiretto
jm:haDiretto rdf:type owl:ObjectProperty ,
                      owl:InverseFunctionalProperty ;
             rdfs:domain jm:Regista ;
             rdfs:range jm:Anime ;
             rdfs:comment "Indica quale aime ha diretto un certo regista"@it ;
             rdfs:label "Ha diretto"@it .


###  http://www.semanticweb.org/japanese-media/haDoppiato
jm:haDoppiato rdf:type owl:ObjectProperty ;
              owl:inverseOf jm:èDoppiatoDa ;
              rdfs:domain jm:VoiceActorOrActress ;
              rdfs:range jm:Anime ;
              rdfs:comment "Indica quali anime ha doppiato un/una doppiatore/doppiatrice"@it ;
              rdfs:label "Ha doppiato"@it .


###  http://www.semanticweb.org/japanese-media/haLavoratoCon
jm:haLavoratoCon rdf:type owl:ObjectProperty ,
                          owl:SymmetricProperty ;
                 rdfs:domain jm:Staff ;
                 rdfs:range jm:Staff ;
                 owl:propertyChainAxiom ( jm:haDiretto
                                          jm:èDoppiatoDa
                                        ) ;
                 rdfs:comment "Indica con quali dipendenti ha lavorato un certo dipendente. Differisce da \"Collega di\" perché non lavorano in una stessa casa editrice, ma hanno solo collaborato"@it ;
                 rdfs:label "Ha lavorato con"@it .


###  http://www.semanticweb.org/japanese-media/haPrequel
jm:haPrequel rdf:type owl:ObjectProperty ;
             owl:inverseOf jm:haSequel ;
             rdf:type owl:TransitiveProperty ;
             rdfs:domain jm:OperaArtistica ;
             rdfs:range jm:OperaArtistica ;
             owl:propertyChainAxiom ( jm:haPrequel
                                      jm:haPrequel
                                    ) ;
             rdfs:comment "Indica quale opera precede l'opera in soggetto"@it ;
             rdfs:label "Ha prequel"@it .


###  http://www.semanticweb.org/japanese-media/haPrimoArcoNarrativo
jm:haPrimoArcoNarrativo rdf:type owl:ObjectProperty ;
                        rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasFirstItem> ;
                        rdf:type owl:InverseFunctionalProperty ;
                        rdfs:domain jm:MangaSerie ;
                        rdfs:range jm:ArcoNarrativo ;
                        rdfs:comment "Indica qual è il primo arco narrativo di un certo manga"@it ;
                        rdfs:label "Ha primo arco narrativo"@it .


###  http://www.semanticweb.org/japanese-media/haProdotto
jm:haProdotto rdf:type owl:ObjectProperty ;
              owl:inverseOf jm:prodottoDa ;
              rdf:type owl:InverseFunctionalProperty ;
              rdfs:domain jm:StudioAnimazione ;
              rdfs:range jm:Anime ;
              rdfs:comment "Indica quale studio di animazione ha prodotto un certo anime"@it ;
              rdfs:label "Ha prodotto"@it .


###  http://www.semanticweb.org/japanese-media/haScritto
jm:haScritto rdf:type owl:ObjectProperty ,
                      owl:InverseFunctionalProperty ;
             rdfs:domain jm:Autore ;
             rdfs:range jm:Manga ;
             rdfs:comment "Indica quali manga ha scritto un certo autore"@it ;
             rdfs:label "Ha scritto"@it .


###  http://www.semanticweb.org/japanese-media/haSequel
jm:haSequel rdf:type owl:ObjectProperty ,
                     owl:TransitiveProperty ;
            rdfs:domain jm:OperaArtistica ;
            rdfs:range jm:OperaArtistica ;
            owl:propertyChainAxiom ( jm:haSequel
                                     jm:haSequel
                                   ) ;
            rdfs:comment "Indica il sequel di una certa opera artistica"@it ;
            rdfs:label "Ha sequel"@it .


###  http://www.semanticweb.org/japanese-media/haTarget
jm:haTarget rdf:type owl:ObjectProperty ;
            owl:inverseOf jm:èTargetDi ;
            rdf:type owl:FunctionalProperty ;
            rdfs:domain jm:OperaNipponica ;
            rdfs:range jm:Target ;
            rdfs:comment "Indica il target di una certa opera artistica"@it ;
            rdfs:label "Ha target"@it .


###  http://www.semanticweb.org/japanese-media/haUltimoArcoNrattaivo
jm:haUltimoArcoNrattaivo rdf:type owl:ObjectProperty ;
                         rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasLastItem> ;
                         rdf:type owl:InverseFunctionalProperty ;
                         rdfs:domain jm:MangaCompleto ;
                         rdfs:range jm:ArcoNarrativo ;
                         rdfs:comment "Indica qual è l'ultimo arco narrativo di un certo manga (solo se completo)"@it ;
                         rdfs:label "Ha ultimo arco narrativo"@it .


###  http://www.semanticweb.org/japanese-media/haVincitore
jm:haVincitore rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#hasParticipant> ;
               owl:inverseOf jm:èVincitoreDi ;
               rdf:type owl:FunctionalProperty ;
               rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
               rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
               rdfs:comment "Dato un evento, indica chi ha vinto tale evento"@it ;
               rdfs:label "Ha vincitore"@it .


###  http://www.semanticweb.org/japanese-media/prodottoDa
jm:prodottoDa rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain jm:Anime ;
              rdfs:range jm:StudioAnimazione ;
              rdfs:comment "Indica da quale studio di animazione è stato prodotto un anime"@it ;
              rdfs:label "Prodotto da"@it .


###  http://www.semanticweb.org/japanese-media/pubblicatoDa
jm:pubblicatoDa rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain jm:Manga ;
                rdfs:range jm:Rivista ;
                rdfs:comment "Indica il manga su che rivista è stato pubblicato"@it ;
                rdfs:label "Pubblicato da"@it .


###  http://www.semanticweb.org/japanese-media/èDoppiatoDa
jm:èDoppiatoDa rdf:type owl:ObjectProperty ;
               rdfs:domain jm:Anime ;
               rdfs:range jm:VoiceActorOrActress ;
               rdfs:comment "Indica da quali doppiatori/doppiatrici è stato doppiato un anime"@it ;
               rdfs:label "E' doppiato da"@it .


###  http://www.semanticweb.org/japanese-media/èTargetDi
jm:èTargetDi rdf:type owl:ObjectProperty ,
                      owl:InverseFunctionalProperty ;
             rdfs:domain jm:Target ;
             rdfs:range jm:OperaNipponica ;
             rdfs:comment "Indica di quali opere è target un target"@it ;
             rdfs:label "E' target di"@it .


###  http://www.semanticweb.org/japanese-media/èVincitoreDi
jm:èVincitoreDi rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#isParticipantIn> ;
                rdf:type owl:InverseFunctionalProperty ;
                rdfs:domain <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Object> ;
                rdfs:range <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
                rdfs:comment "Indica iil vincitore di un evento"@it ;
                rdfs:label "E' vincitore di"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/japanese-media/inProduzione
jm:inProduzione rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain jm:OperaNipponica ;
                rdfs:range xsd:boolean ;
                rdfs:comment "Indica se un'opera nipponica è in produzione (true) o è terminata (false)"@it ;
                rdfs:label "In produzione"@it .


###  http://www.semanticweb.org/japanese-media/numeroEpisodi
jm:numeroEpisodi rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain jm:AnimeSerie ;
                 rdfs:range xsd:integer ;
                 rdfs:comment "Indica con un intero il numero di episodi di una serie anime"@it ;
                 rdfs:label "Numero di episodi"@it .


###  http://www.semanticweb.org/japanese-media/numeroVolumi
jm:numeroVolumi rdf:type owl:DatatypeProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain jm:Manga ;
                rdfs:range xsd:integer ;
                rdfs:comment "Indica il numero di volumi di un manga"@it ;
                rdfs:label "Numero volumi"@it .


###  http://www.semanticweb.org/japanese-media/prezzoVolumeEuro
jm:prezzoVolumeEuro rdf:type owl:DatatypeProperty ,
                             owl:FunctionalProperty ;
                    rdfs:domain jm:Manga ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Prezzo di un volume di un manga in euro"@it ;
                    rdfs:label "Prezzo volume in euro"@it .


###  http://www.semanticweb.org/japanese-media/titoloAlternativo
jm:titoloAlternativo rdf:type owl:DatatypeProperty ;
                     rdfs:domain jm:OperaNipponica ;
                     rdfs:range xsd:string ;
                     rdfs:comment "Titolo alternativo di un'opera nipponica. Accade spesso che il titolo venga accorciato con un titolo più breve"@it ;
                     rdfs:label "Titolo alternativo"@it .


###  http://www.semanticweb.org/japanese-media/èStagionale
jm:èStagionale rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain jm:AnimeSerie ;
               rdfs:range xsd:boolean ;
               rdfs:comment "Indica se un anime è stagionale o long running"@it ;
               rdfs:label "E' stagionale"@it .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/japanese-media/Anime
jm:Anime rdf:type owl:Class ;
         rdfs:subClassOf jm:OperaNipponica ;
         owl:disjointWith jm:Manga ;
         rdfs:comment "Prodotto di animazione giapponese spesso tratto da manga o videogames"@it ;
         rdfs:label "Anime"@it ;
         <http://www.w3.org/2004/02/skos/core#broadMatch> "https://schema.org/VideoObject" ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> "http://www.wikidata.org/entity/Q1107" .


###  http://www.semanticweb.org/japanese-media/AnimeAward
jm:AnimeAward rdf:type owl:Class ;
              rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/participation.owl#Event> ;
              rdfs:comment "Premio annuale per migliori anime"@it ;
              rdfs:label "Anime award"@it ;
              <http://www.w3.org/2004/02/skos/core#broadMatch> "https://schema.org/award" ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q105725170" .


###  http://www.semanticweb.org/japanese-media/AnimeFilm
jm:AnimeFilm rdf:type owl:Class ;
             rdfs:subClassOf jm:Anime ;
             rdfs:comment "Film di animazione giapponese"@it ;
             rdfs:label "Film anime"@it ;
             <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/Movie" ;
             <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q20650540" .


###  http://www.semanticweb.org/japanese-media/AnimeSerie
jm:AnimeSerie rdf:type owl:Class ;
              rdfs:subClassOf jm:Anime ;
              rdfs:comment "Serie di episodi di animazione giapponese"@it ;
              rdfs:label "Serie anime"@it ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q117467261" .


###  http://www.semanticweb.org/japanese-media/ArcoNarrativo
jm:ArcoNarrativo rdf:type owl:Class ;
                 owl:equivalentClass [ rdf:type owl:Class ;
                                       owl:unionOf ( [ owl:intersectionOf ( <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item>
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows> ;
                                                                              owl:someValuesFrom jm:ArcoNarrativo
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                                     [ owl:intersectionOf ( <http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem>
                                                                            [ rdf:type owl:Restriction ;
                                                                              owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemOf> ;
                                                                              owl:someValuesFrom jm:MangaSerie
                                                                            ]
                                                                          ) ;
                                                       rdf:type owl:Class
                                                     ]
                                                   )
                                     ] ;
                 rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem> ;
                 rdfs:comment "Serie di capitoli all'interno di una serie manga che descrivono lo svolgersi di eventi inerenti una \"sottostoria\""@it ;
                 rdfs:label "Arco narrativo"@it .


###  http://www.semanticweb.org/japanese-media/Autore
jm:Autore rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( jm:Persona
                                                     [ rdf:type owl:Restriction ;
                                                       owl:onProperty jm:haScritto ;
                                                       owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                       owl:onClass jm:Manga
                                                     ]
                                                   ) ;
                                rdf:type owl:Class
                              ] ;
          rdfs:subClassOf jm:Persona ;
          rdfs:comment "Persona che scrive un'opera letteraria, come i manga"@it ;
          rdfs:label "Autore"@it ;
          <http://www.w3.org/2004/02/skos/core#exactMatch> "https://schema.org/author" ,
                                                           "https://www.wikidata.org/wiki/Q482980" .


###  http://www.semanticweb.org/japanese-media/CasaEditrice
jm:CasaEditrice rdf:type owl:Class ;
                rdfs:subClassOf jm:Organizzazione ;
                rdfs:comment "Organizzazione che si occupa della pubblicazione di opere letterarie"@it ;
                rdfs:label "Casa editrice"@it ;
                <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/publisher" ;
                <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q2085381" .


###  http://www.semanticweb.org/japanese-media/LongRunning
jm:LongRunning rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( jm:AnimeSerie
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty jm:èStagionale ;
                                                            owl:hasValue "false"^^xsd:boolean
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf jm:AnimeSerie ;
               rdfs:comment "Serie anime non divisa per stagioni ma con continua pubblicazione di episodi in maniera regolare"@it ;
               rdfs:label "Long running"@en ;
               <http://www.w3.org/2004/02/skos/core#broadMatch> "https://www.wikidata.org/wiki/Q63952888" .


###  http://www.semanticweb.org/japanese-media/Manga
jm:Manga rdf:type owl:Class ;
         owl:equivalentClass [ owl:intersectionOf ( jm:OperaNipponica
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty jm:pubblicatoDa ;
                                                      owl:someValuesFrom jm:Rivista
                                                    ]
                                                  ) ;
                               rdf:type owl:Class
                             ] ;
         rdfs:subClassOf jm:OperaNipponica ;
         rdfs:comment "Opera scritta di origine nipponica composta da disegni e testo. E' l'equivalente del fumetto italiano. Si legge al contrario"@it ;
         rdfs:label "Manga"@it ;
         <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/ComicSeries" ;
         <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q8274" .


###  http://www.semanticweb.org/japanese-media/MangaCompleto
jm:MangaCompleto rdf:type owl:Class ;
                 owl:equivalentClass [ owl:intersectionOf ( jm:MangaSerie
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty jm:numeroVolumi ;
                                                              owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                   owl:onDatatype xsd:integer ;
                                                                                   owl:withRestrictions ( [ xsd:minInclusive 2
                                                                                                          ]
                                                                                                        )
                                                                                 ]
                                                            ]
                                                            [ rdf:type owl:Restriction ;
                                                              owl:onProperty jm:inProduzione ;
                                                              owl:hasValue "false"^^xsd:boolean
                                                            ]
                                                          ) ;
                                       rdf:type owl:Class
                                     ] ;
                 rdfs:subClassOf jm:MangaSerie ;
                 rdfs:comment "Serie manga di cui è stata conclusa la narrazione"@it ;
                 rdfs:label "Manga Completo"@it .


###  http://www.semanticweb.org/japanese-media/MangaInCorso
jm:MangaInCorso rdf:type owl:Class ;
                owl:equivalentClass [ owl:intersectionOf ( jm:MangaSerie
                                                           [ rdf:type owl:Restriction ;
