@prefix : <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@base <http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/> .

<http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16> rdf:type owl:Ontology ;
                                                                           owl:imports <http://www.ontologydesignpatterns.org/cp/owl/list.owl> ,
                                                                                       <http://www.w3.org/2004/02/skos/core> ;
                                                                           dc:creator "Frattarola Marco" ,
                                                                                      "Ghione Alessio" ;
                                                                           dc:date "2025-01-20" ;
                                                                           dc:description "An ontology describing various aspects of Japanese media, including anime, manga, and related concepts."@en ,
                                                                                          "Un'ontologia che descrive vari aspetti dei media giapponesi, inclusi anime, manga e concetti correlati"@it ;
                                                                           dc:title "Japanese Media Ontology"@en ;
                                                                           vann:preferredNamespacePrefix "jm" ;
                                                                           vann:preferredNamespaceUri "http://www.semanticweb.org/japanese-media/" ;
                                                                           rdfs:label "Japanese media" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/creator
dc:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
dc:date rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
dc:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/title
dc:title rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
vann:preferredNamespacePrefix rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
vann:preferredNamespaceUri rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
<http://www.w3.org/2004/02/skos/core#broadMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
<http://www.w3.org/2004/02/skos/core#exactMatch> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://www.w3.org/2001/XMLSchema#gYear
xsd:gYear rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/appartieneA
:appartieneA rdf:type owl:ObjectProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :Rivista ;
             rdfs:range :CasaEditrice ;
             rdfs:comment "Indica la rivista a quale casa editrice appartiene"@it ;
             rdfs:label "Appartiene a"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/collegaDi
:collegaDi rdf:type owl:ObjectProperty ,
                    owl:SymmetricProperty ,
                    owl:TransitiveProperty ;
           rdfs:domain :Staff ;
           rdfs:range :Staff ;
           rdfs:comment "Crea un collegamento che lega due colleghi"@it ;
           rdfs:label "Collega di"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/detieneDiritti
:detieneDiritti rdf:type owl:ObjectProperty ;
                rdfs:domain :CasaEditrice ;
                rdfs:range :Manga ;
                owl:propertyChainAxiom ( :pubblicatoDa
                                         :appartieneA
                                       ) ;
                rdfs:comment "Indica quale casa editrice detiene i diritti di pubblicazione di un certo manga"@it ;
                rdfs:label "Detiene diritti"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/dipendenteDi
:dipendenteDi rdf:type owl:ObjectProperty ;
              rdfs:domain :Staff ;
              rdfs:range :StudioAnimazione ;
              owl:propertyChainAxiom ( :haDiretto
                                       :prodottoDa
                                     ) ;
              rdfs:comment "Indica di quale studio di animazione è dipendente un dipendente"@it ;
              rdfs:label "Dipendente di"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/direttoDa
:direttoDa rdf:type owl:ObjectProperty ;
           owl:inverseOf :haDiretto ;
           rdf:type owl:FunctionalProperty ;
           rdfs:domain :Anime ;
           rdfs:range :Regista ;
           rdfs:comment "Indica il regista di un determinato anime"@it ;
           rdfs:label "Diretto da"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haAdattamentoAnime
:haAdattamentoAnime rdf:type owl:ObjectProperty ;
                    rdfs:domain :Manga ;
                    rdfs:range :Anime ;
                    rdfs:comment "Dato un manga indica quale anime è il suo adattamento"@it ;
                    rdfs:label "Ha adattamento anime"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haAutore
:haAutore rdf:type owl:ObjectProperty ;
          owl:inverseOf :haScritto ;
          rdf:type owl:FunctionalProperty ;
          rdfs:domain :Manga ;
          rdfs:range :Autore ;
          rdfs:comment "Indica quale autore ha scritto una determinata opera artistica"@it ;
          rdfs:label "Ha autore"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haDiretto
:haDiretto rdf:type owl:ObjectProperty ,
                    owl:InverseFunctionalProperty ;
           rdfs:domain :Regista ;
           rdfs:range :Anime ;
           rdfs:comment "Indica quale aime ha diretto un certo regista"@it ;
           rdfs:label "Ha diretto"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haDoppiato
:haDoppiato rdf:type owl:ObjectProperty ;
            owl:inverseOf :èDoppiatoDa ;
            rdfs:domain :VoiceActorOrActress ;
            rdfs:range :Anime ;
            rdfs:comment "Indica quali anime ha doppiato un/una doppiatore/doppiatrice"@it ;
            rdfs:label "Ha doppiato"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haLavoratoCon
:haLavoratoCon rdf:type owl:ObjectProperty ,
                        owl:SymmetricProperty ;
               rdfs:domain :Staff ;
               rdfs:range :Staff ;
               owl:propertyChainAxiom ( :haDiretto
                                        :èDoppiatoDa
                                      ) ;
               rdfs:comment "Indica con quali dipendenti ha lavorato un certo dipendente. Differisce da \"Collega di\" perché non lavorano in una stessa casa editrice, ma hanno solo collaborato"@it ;
               rdfs:label "Ha lavorato con"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haPrequel
:haPrequel rdf:type owl:ObjectProperty ;
           owl:inverseOf :haSequel ;
           rdf:type owl:TransitiveProperty ;
           rdfs:domain :OperaArtistica ;
           rdfs:range :OperaArtistica ;
           owl:propertyChainAxiom ( :haPrequel
                                    :haPrequel
                                  ) ;
           rdfs:comment "Indica quale opera precede l'opera in soggetto"@it ;
           rdfs:label "Ha prequel"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haPrimoArcoNarrativo
:haPrimoArcoNarrativo rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasFirstItem> ;
                      rdf:type owl:InverseFunctionalProperty ;
                      rdfs:domain :MangaSerie ;
                      rdfs:range :ArcoNarrativo ;
                      rdfs:comment "Indica qual è il primo arco narrativo di un certo manga"@it ;
                      rdfs:label "Ha primo arco narrativo"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haProdotto
:haProdotto rdf:type owl:ObjectProperty ;
            owl:inverseOf :prodottoDa ;
            rdf:type owl:InverseFunctionalProperty ;
            rdfs:domain :StudioAnimazione ;
            rdfs:range :Anime ;
            rdfs:comment "Indica quale studio di animazione ha prodotto un certo anime"@it ;
            rdfs:label "Ha prodotto"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haScritto
:haScritto rdf:type owl:ObjectProperty ,
                    owl:InverseFunctionalProperty ;
           rdfs:domain :Autore ;
           rdfs:range :Manga ;
           rdfs:comment "Indica quali manga ha scritto un certo autore"@it ;
           rdfs:label "Ha scritto"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haSequel
:haSequel rdf:type owl:ObjectProperty ,
                   owl:TransitiveProperty ;
          rdfs:domain :OperaArtistica ;
          rdfs:range :OperaArtistica ;
          owl:propertyChainAxiom ( :haSequel
                                   :haSequel
                                 ) ;
          rdfs:comment "Indica il sequel di una certa opera artistica"@it ;
          rdfs:label "Ha sequel"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haTarget
:haTarget rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :OperaNipponica ;
          rdfs:range :Target ;
          rdfs:comment "Indica il target di una certa opera artistica"@it ;
          rdfs:label "Ha target"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/haUltimoArcoNrattaivo
:haUltimoArcoNrattaivo rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#hasLastItem> ;
                       rdf:type owl:InverseFunctionalProperty ;
                       rdfs:domain :MangaCompleto ;
                       rdfs:range :ArcoNarrativo ;
                       rdfs:comment "Indica qual è l'ultimo arco narrativo di un certo manga (solo se completo)"@it ;
                       rdfs:label "Ha ultimo arco narrativo"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/prodottoDa
:prodottoDa rdf:type owl:ObjectProperty ,
                     owl:FunctionalProperty ;
            rdfs:domain :Anime ;
            rdfs:range :StudioAnimazione ;
            rdfs:comment "Indica da quale studio di animazione è stato prodotto un anime"@it ;
            rdfs:label "Prodotto da"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/pubblicatoDa
:pubblicatoDa rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Manga ;
              rdfs:range :Rivista ;
              rdfs:comment "Indica il manga su che rivista è stato pubblicato"@it ;
              rdfs:label "Pubblicato da"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/èDoppiatoDa
:èDoppiatoDa rdf:type owl:ObjectProperty ;
             rdfs:domain :Anime ;
             rdfs:range :VoiceActorOrActress ;
             rdfs:comment "Indica da quali doppiatori/doppiatrici è stato doppiato un anime"@it ;
             rdfs:label "E' doppiato da"@it .


#################################################################
#    Data properties
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/inProduzione
:inProduzione rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :OperaNipponica ;
              rdfs:range xsd:boolean ;
              rdfs:comment "Indica se un'opera nipponica è in produzione (true) o è terminata (false)"@it ;
              rdfs:label "In produzione"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/numeroEpisodi
:numeroEpisodi rdf:type owl:DatatypeProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :AnimeSerie ;
               rdfs:range xsd:integer ;
               rdfs:comment "Indica con un intero il numero di episodi di una serie anime"@it ;
               rdfs:label "Numero di episodi"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/numeroVolumi
:numeroVolumi rdf:type owl:DatatypeProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :Manga ;
              rdfs:range xsd:integer ;
              rdfs:comment "Indica il numero di volumi di un manga"@it ;
              rdfs:label "Numero volumi"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/prezzoVolumeEuro
:prezzoVolumeEuro rdf:type owl:DatatypeProperty ,
                           owl:FunctionalProperty ;
                  rdfs:domain :Manga ;
                  rdfs:range xsd:decimal ;
                  rdfs:comment "Prezzo di un volume di un manga in euro"@it ;
                  rdfs:label "Prezzo volume in euro"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/titoloAlternativo
:titoloAlternativo rdf:type owl:DatatypeProperty ;
                   rdfs:domain :OperaNipponica ;
                   rdfs:range xsd:string ;
                   rdfs:comment "Titolo alternativo di un'opera nipponica. Accade spesso che il titolo venga accorciato con un titolo più breve"@it ;
                   rdfs:label "Titolo alternativo"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/èStagionale
:èStagionale rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain :AnimeSerie ;
             rdfs:range xsd:boolean ;
             rdfs:comment "Indica se un anime è stagionale o long running"@it ;
             rdfs:label "E' stagionale"@it .


#################################################################
#    Classes
#################################################################

###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Anime
:Anime rdf:type owl:Class ;
       rdfs:subClassOf :OperaNipponica ;
       owl:disjointWith :Manga ;
       rdfs:comment "Prodotto di animazione giapponese spesso tratto da manga o videogames"@it ;
       rdfs:label "Anime"@it ;
       <http://www.w3.org/2004/02/skos/core#broadMatch> "https://schema.org/VideoObject" ;
       <http://www.w3.org/2004/02/skos/core#exactMatch> "http://www.wikidata.org/entity/Q1107" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/AnimeFilm
:AnimeFilm rdf:type owl:Class ;
           rdfs:subClassOf :Anime ;
           rdfs:comment "Film di animazione giapponese"@it ;
           rdfs:label "Film anime"@it ;
           <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/Movie" ;
           <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q20650540" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/AnimeSerie
:AnimeSerie rdf:type owl:Class ;
            rdfs:subClassOf :Anime ;
            rdfs:comment "Serie di episodi di animazione giapponese"@it ;
            rdfs:label "Serie anime"@it ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q117467261" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/ArcoNarrativo
:ArcoNarrativo rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Class ;
                                     owl:unionOf ( [ owl:intersectionOf ( <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#Item>
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/sequence.owl#follows> ;
                                                                            owl:someValuesFrom :ArcoNarrativo
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ]
                                                   [ owl:intersectionOf ( <http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem>
                                                                          [ rdf:type owl:Restriction ;
                                                                            owl:onProperty <http://www.ontologydesignpatterns.org/cp/owl/bag.owl#itemOf> ;
                                                                            owl:someValuesFrom :MangaSerie
                                                                          ]
                                                                        ) ;
                                                     rdf:type owl:Class
                                                   ]
                                                 )
                                   ] ;
               rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#ListItem> ;
               rdfs:comment "Serie di capitoli all'interno di una serie manga che descrivono lo svolgersi di eventi inerenti una \"sottostoria\""@it ;
               rdfs:label "Arco narrativo"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Autore
:Autore rdf:type owl:Class ;
        owl:equivalentClass [ owl:intersectionOf ( :Persona
                                                   [ rdf:type owl:Restriction ;
                                                     owl:onProperty :haScritto ;
                                                     owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                     owl:onClass :Manga
                                                   ]
                                                 ) ;
                              rdf:type owl:Class
                            ] ;
        rdfs:subClassOf :Persona ;
        rdfs:comment "Persona che scrive un'opera letteraria, come i manga"@it ;
        rdfs:label "Autore"@it ;
        <http://www.w3.org/2004/02/skos/core#exactMatch> "https://schema.org/author" ,
                                                         "https://www.wikidata.org/wiki/Q482980" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/CasaEditrice
:CasaEditrice rdf:type owl:Class ;
              rdfs:subClassOf :Organizzazione ;
              rdfs:comment "Organizzazione che si occupa della pubblicazione di opere letterarie"@it ;
              rdfs:label "Casa editrice"@it ;
              <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/publisher" ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q2085381" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/LongRunning
:LongRunning rdf:type owl:Class ;
             owl:equivalentClass [ owl:intersectionOf ( :AnimeSerie
                                                        [ rdf:type owl:Restriction ;
                                                          owl:onProperty :èStagionale ;
                                                          owl:hasValue "false"^^xsd:boolean
                                                        ]
                                                      ) ;
                                   rdf:type owl:Class
                                 ] ;
             rdfs:subClassOf :AnimeSerie ;
             rdfs:comment "Serie anime non divisa per stagioni ma con continua pubblicazione di episodi in maniera regolare"@it ;
             rdfs:label "Long running"@en ;
             <http://www.w3.org/2004/02/skos/core#broadMatch> "https://www.wikidata.org/wiki/Q63952888" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/Manga
:Manga rdf:type owl:Class ;
       owl:equivalentClass [ owl:intersectionOf ( :OperaNipponica
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty :pubblicatoDa ;
                                                    owl:someValuesFrom :Rivista
                                                  ]
                                                ) ;
                             rdf:type owl:Class
                           ] ;
       rdfs:subClassOf :OperaNipponica ;
       rdfs:comment "Opera scritta di origine nipponica composta da disegni e testo. E' l'equivalente del fumetto italiano. Si legge al contrario"@it ;
       rdfs:label "Manga"@it ;
       <http://www.w3.org/2004/02/skos/core#closeMatch> "https://schema.org/ComicSeries" ;
       <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q8274" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaCompleto
:MangaCompleto rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( :MangaSerie
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :numeroVolumi ;
                                                            owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                 owl:onDatatype xsd:integer ;
                                                                                 owl:withRestrictions ( [ xsd:minInclusive 2
                                                                                                        ]
                                                                                                      )
                                                                               ]
                                                          ]
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty :inProduzione ;
                                                            owl:hasValue "false"^^xsd:boolean
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf :MangaSerie ;
               rdfs:comment "Serie manga di cui è stata conclusa la narrazione"@it ;
               rdfs:label "Manga Completo"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaInCorso
:MangaInCorso rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :MangaSerie
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :numeroVolumi ;
                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                owl:onDatatype xsd:integer ;
                                                                                owl:withRestrictions ( [ xsd:minInclusive 1
                                                                                                       ]
                                                                                                     )
                                                                              ]
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :inProduzione ;
                                                           owl:hasValue "true"^^xsd:boolean
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :MangaSerie ;
              rdfs:comment "Serie manga di cui la pubblicazione è ancora in corso e non è terminata"@it ;
              rdfs:label "Manga in corso"@it .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaOneShot
:MangaOneShot rdf:type owl:Class ;
              owl:equivalentClass [ owl:intersectionOf ( :Manga
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :inProduzione ;
                                                           owl:hasValue "false"^^xsd:boolean
                                                         ]
                                                         [ rdf:type owl:Restriction ;
                                                           owl:onProperty :numeroVolumi ;
                                                           owl:hasValue 1
                                                         ]
                                                       ) ;
                                    rdf:type owl:Class
                                  ] ;
              rdfs:subClassOf :Manga ;
              rdfs:comment "Fumetto giapponese composto da un solo volume con storia autoconclusiva"@it ;
              rdfs:label "Manga one shot"@en ;
              <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q21202185" .


###  http://www.semanticweb.org/marco/ontologies/2025/0/untitled-ontology-16/MangaSerie
:MangaSerie rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :Manga
                                                       [ rdf:type owl:Class ;
                                                         owl:unionOf ( [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :numeroVolumi ;
                                                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                     owl:onDatatype xsd:integer ;
                                                                                                                     owl:withRestrictions ( [ xsd:minInclusive 1
                                                                                                                                            ]
                                                                                                                                          )
                                                                                                                   ]
                                                                                              ]
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :inProduzione ;
                                                                                                owl:hasValue "true"^^xsd:boolean
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ]
                                                                       [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :numeroVolumi ;
                                                                                                owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                                     owl:onDatatype xsd:integer ;
                                                                                                                     owl:withRestrictions ( [ xsd:minInclusive 2
                                                                                                                                            ]
                                                                                                                                          )
                                                                                                                   ]
                                                                                              ]
                                                                                              [ rdf:type owl:Restriction ;
                                                                                                owl:onProperty :inProduzione ;
                                                                                                owl:hasValue "false"^^xsd:boolean
                                                                                              ]
                                                                                            ) ;
                                                                         rdf:type owl:Class
                                                                       ]
                                                                     )
                                                       ]
                                                     ) ;
                                  rdf:type owl:Class
                                ] ;
            rdfs:subClassOf <http://www.ontologydesignpatterns.org/cp/owl/list.owl#List> ,
                            :Manga ;
            rdfs:comment "Manga composto da più volumi"@it ;
            rdfs:label "Serie Manga"@it ;
            <http://www.w3.org/2004/02/skos/core#exactMatch> "https://www.wikidata.org/wiki/Q21198342" .


